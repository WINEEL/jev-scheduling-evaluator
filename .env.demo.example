# Local demo environment. Copy to `.env.demo` (git-ignored) and fill in.
#
# This is NOT a fourth database branch. It points at the existing Neon
# `development` branch — the same one used for ordinary backend development —
# while explicitly opting into demo seeding at the same time. Loading this
# file and running `python scripts/seed_demo.py` is a deliberate, separate
# step; nothing here is read implicitly by the application or by anything
# else in this repository.
#
# It must not be the integration-test branch — the seed refuses to run if it
# detects that. There is no check that can recognize the production branch by
# its hostname alone; the safety here is the explicit opt-in below plus an
# exact match against the host you name, not shape-matching.
#
# Placeholders only. Never commit real hosts or credentials.

# Connection string for the development branch (synchronous psycopg 3 driver).
DATABASE_URL=""

# The host of that same development branch, used by the seed to prove where
# it is writing. Just the hostname, e.g. ep-example-123456.region.aws.neon.tech
CHURCH_SCHEDULING_DEMO_DATABASE_HOST=""

# Both required, exactly as written, or the seed refuses.
APP_ENV="development"
CHURCH_SCHEDULING_ALLOW_DEMO_SEED=1
