# Local development configuration for the frontend.
#
# Copy to `.env.local` (git-ignored) and fill in your own values.
# Never commit a real Person id.

# Where FastAPI is listening. The browser never sees this: it is read on the
# server by the /api/backend proxy.
CHURCH_SCHEDULING_API_URL=http://127.0.0.1:8000

# Development identity. NOT authentication — see the README.
# Must be exactly "1" to have any effect, and is refused outright in a
# production build.
CHURCH_SCHEDULING_FRONTEND_DEV_AUTH=1

# The Person to act as locally. There is no default and no fallback: leave
# this unset and every request is unauthenticated.
CHURCH_SCHEDULING_FRONTEND_DEV_ACTOR_PERSON_ID=<YOUR_TEST_PERSON_ID>

# Optional, presentation only: the ministries whose scheduling configuration
# has been validated with their own ministry head. Comma separated, matched
# against the ministry's name (case and spacing are ignored).
#
# Leave it unset and no ministry is described as validated *or* as an
# unvalidated example -- the home page simply says nothing either way, which is
# the honest default. The backend stores no such fact; this is configuration,
# not domain data.
CHURCH_SCHEDULING_FRONTEND_PILOT_VALIDATED_MINISTRIES=
