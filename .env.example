# Copy this file to `.env` and fill in local values. `.env` is git-ignored.
# Use placeholders / local values only. Never commit real credentials or secrets.

# --- Backend: development database ---
# Development PostgreSQL is hosted on Neon; there is no local PostgreSQL server.
# For local development, use the connection string of your Neon *development
# branch* (never the production branch).
# The backend uses the synchronous psycopg 3 driver, so the URL scheme must be
# "postgresql+psycopg://" and, per Neon, include "?sslmode=require".
# Keep this blank. Put the real value only in the git-ignored .env.
DATABASE_URL=""

# Application environment: development | test | production
#
# Load-bearing, not a label. Setting it to "production":
#   - marks the session cookie Secure;
#   - disables CHURCH_SCHEDULING_DEV_AUTH outright, whatever it is set to;
#   - refuses to start unless Google sign-in is fully configured.
APP_ENV="development"

# --- Frontend ---
# Base URL the frontend uses to reach the backend API during development.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# --- Authentication: Google sign-in (Task 76) ---
# Do NOT fill in real values in this file. Put them only in the git-ignored
# `.env`, and in GCP Secret Manager for the deployed pilot.
# See docs/architecture/authentication.md for where each one comes from.

# The OAuth web client's id and secret, from the Google Cloud console.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Signing key for the session cookie. Any long random string; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank locally, a temporary key is generated per process and sessions do
# not survive a restart. A production deployment refuses to start without it.
SESSION_SECRET=""

# The exact, absolute URL Google redirects back to after sign-in. It must match
# an Authorized redirect URI on the OAuth client character for character.
# Locally, with the frontend on :3000 proxying to the backend:
#   http://localhost:3000/api/backend/api/v1/auth/google/callback
OAUTH_REDIRECT_URL=""
