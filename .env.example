# Copy to `.env` and fill in. `.env` is git-ignored.
#
# This is the whole configuration surface of the project. There is no database,
# no authentication and no deployment config, so there is nothing else to set.

# --- The only credential ---
# Your TypeSafe API key, from https://typesafe.ai
#
# Read by the TypeSafe SDK itself, in the backend process, at the moment an
# evaluation is requested. It never reaches the browser: the frontend calls its
# own origin, and the key is not in any response.
#
# Optional for starting up. Without it the backend still runs and the three
# scenarios still load with their arithmetic; only "Evaluate with Jev" fails,
# and the page says why.
TYPESAFE_API_KEY=""

# --- Optional ---
# Where the frontend's proxy looks for the backend. Defaults to
# http://127.0.0.1:8000, which is the port the documented command uses.
# JEV_DEMO_API_URL="http://127.0.0.1:8000"
